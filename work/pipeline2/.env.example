# 复制为 .env 后填写；管线启动时自动加载（已在 shell 里 export 的变量优先）。
# .env 已被 .gitignore 拦截，永不入库。各 Key 申请方式与选型理由见 docs/API_SETUP.md

# ---- run 主流程必需：TEXT 与 VISION 两个角色 ----
# TEXT：转写整理 polish + reduce 目录编排（默认 provider=deepseek）
ECHONOTES_TEXT_PROVIDER=
ECHONOTES_TEXT_BASE_URL=
ECHONOTES_TEXT_MODEL=
ECHONOTES_TEXT_API_KEY=

# VISION：窗口 map 与公式复查（推荐硅基流动 Qwen3-VL，国内直连）
ECHONOTES_VISION_PROVIDER=siliconflow
ECHONOTES_VISION_BASE_URL=https://api.siliconflow.cn/v1
ECHONOTES_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
ECHONOTES_VISION_API_KEY=

# 也可以用密码书代替上面的角色变量（二选一即可）
ECHONOTES_SECRETS_FILE=

# ---- study 学习讲义阶段需要：planner（百炼）+ writer（Kimi）----
# ECHONOTES_PLANNER_PROVIDER=bailian
# ECHONOTES_PLANNER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ECHONOTES_PLANNER_MODEL=qwen3.8-max
# ECHONOTES_PLANNER_API_KEY=
# ECHONOTES_WRITER_PROVIDER=moonshot
# ECHONOTES_WRITER_BASE_URL=https://api.moonshot.cn/v1
# ECHONOTES_WRITER_MODEL=kimi-k2.6
# ECHONOTES_WRITER_TEMPERATURE=1
# ECHONOTES_WRITER_API_KEY=

# ---- 可选：请求策略、思考模式与本地 ASR ----
# ECHONOTES_MODEL_TIMEOUT=180      # 单次请求超时（秒）
# ECHONOTES_MODEL_RETRIES=3        # 最大尝试次数
# ECHONOTES_MODEL_BACKOFF=10       # 重试退避基数（秒）
# ECHONOTES_MODEL_MIN_INTERVAL=0   # 同一角色两次请求的最小间隔（秒）；限流账号设 21
#                                  # 时钟落盘到运行目录，重启续跑仍计时；并行 N 个进程
#                                  # 合计 RPM 约乘 N，限流账号请加倍或错峰
#
# 思考模型（如 Kimi K2.6 默认思考）会消耗输出预算导致 finish_reason=length 时，
# 可关闭思考或调大预算。每个角色独立配置，例如 TEXT 角色关闭思考（非思考模式建议温度 0.6）：
# ECHONOTES_TEXT_EXTRA_BODY={"thinking":{"type":"disabled"}}
# 注意：EXTRA_BODY 不得覆盖保留键 model/messages/stream/response_format/temperature/max_tokens，
# 否则实际请求会与缓存身份脱节（启动时即报错拒绝）。
# ECHONOTES_TEXT_TEMPERATURE=0.6
# ECHONOTES_TEXT_MAX_TOKENS=8192
#
# ECHONOTES_ASR_PYTHON=            # 指向装了 faster-whisper 的独立环境
# ECHONOTES_ASR_MODEL=small
